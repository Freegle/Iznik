# Freegle Helper driver config. Copy to config.env and fill in.
#
# Runs on ANY offerer account: supply that account's JWT (or a persistent token)
# and the clearance message id to manage. The Helper acts as the offerer.

# apiv2 base URL (no trailing slash). Local worktree example shown; for live use
# https://api.ilovefreegle.org/apiv2
APIV2=http://localhost:12046/api

# The offerer's auth. Provide a JWT directly, or a PERSISTENT_TOKEN to exchange.
JWT=
# PERSISTENT_TOKEN=

# The clearance message (bulk offer) to manage.
MSGID=

# Cheap poll cadence (seconds) and how often to run a timeout/nudge tick even when
# nothing changed (seconds).
POLL_INTERVAL=30
TIMEOUT_TICK=3600

# Model for the FSM brain. Subscription billing — the loop unsets ANTHROPIC_API_KEY.
HELPER_MODEL=claude-opus-4-8
