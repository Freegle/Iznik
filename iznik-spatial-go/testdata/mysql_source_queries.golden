QUERY: -- locations Load
ARGS: []

QUERY: 
		SELECT
			locations.id,
			locations.name,
			locations.type,
			ST_Area(COALESCE(ourgeometry, geometry))  AS area,
			ST_AsWKB(COALESCE(ourgeometry, geometry)) AS wkb
		FROM locations
		LEFT JOIN locations_excluded le ON locations.id = le.locationid
		WHERE le.locationid IS NULL
		  AND COALESCE(ourgeometry, geometry) IS NOT NULL
		  AND ST_Dimension(COALESCE(ourgeometry, geometry)) = 2
		  AND ST_Area(COALESCE(ourgeometry, geometry)) BETWEEN ? AND ?
	
ARGS: [1e-05 | 0.15]

QUERY: -- locations ApplyDelta
ARGS: []

QUERY: SELECT locationid FROM locations_excluded
ARGS: []

QUERY: 
		SELECT
			locations.id,
			locations.name,
			locations.type,
			ST_Area(COALESCE(ourgeometry, geometry))  AS area,
			ST_AsWKB(COALESCE(ourgeometry, geometry)) AS wkb
		FROM locations
		LEFT JOIN locations_excluded le ON locations.id = le.locationid
		WHERE le.locationid IS NULL
		  AND COALESCE(ourgeometry, geometry) IS NOT NULL
		  AND ST_Dimension(COALESCE(ourgeometry, geometry)) = 2
		  AND ST_Area(COALESCE(ourgeometry, geometry)) BETWEEN ? AND ?
	 AND locations.timestamp > '2026-11-12 10:00:00'
ARGS: [1e-05 | 0.15]

QUERY: -- messages Load
ARGS: []

QUERY: 
		SELECT ms.msgid,
		       ST_X(ms.point) AS lng,
		       ST_Y(ms.point) AS lat,
		       COALESCE(ms.msgtype, '') AS msgtype, ms.groupid,
		       CASE WHEN mp.id IS NOT NULL THEN 1 ELSE 0 END AS promised
		FROM messages_spatial ms
		LEFT JOIN messages_promises mp ON mp.msgid = ms.msgid
		WHERE ms.successful = 0
	
ARGS: []

QUERY: -- messages ApplyDelta
ARGS: []

QUERY: 
		SELECT ms.msgid,
		       ST_X(ms.point) AS lng,
		       ST_Y(ms.point) AS lat,
		       COALESCE(ms.msgtype, '') AS msgtype, ms.groupid,
		       CASE WHEN mp.id IS NOT NULL THEN 1 ELSE 0 END AS promised,
		       ms.successful
		FROM messages_spatial ms
		LEFT JOIN messages_promises mp ON mp.msgid = ms.msgid
		WHERE ms.modified > ?
	
ARGS: [2026-11-12 10:00:00 +0000 UTC]

QUERY: -- newsfeed Load
ARGS: []

QUERY: 
		SELECT id, ST_X(position) AS lng, ST_Y(position) AS lat, COALESCE(type, '') AS type, COALESCE(userid, 0) AS userid
		FROM newsfeed
		WHERE deleted IS NULL
		  AND replyto IS NULL
		  AND position IS NOT NULL
	
ARGS: []

QUERY: -- newsfeed ApplyDelta
