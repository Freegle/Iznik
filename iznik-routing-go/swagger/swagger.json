{
  "produces": [
    "application/json"
  ],
  "schemes": [
    "http"
  ],
  "swagger": "2.0",
  "info": {
    "description": "A routing and isochrone service for finding reachable areas from a given\nlocation using walk, cycle, and drive travel modes based on OpenStreetMap data.",
    "title": "Freegle Routing \u0026 Isochrone API",
    "version": "1.0.0"
  },
  "basePath": "/",
  "paths": {
    "/demo": {
      "get": {
        "description": "Returns an interactive HTML demo page for the routing service.",
        "produces": [
          "text/html"
        ],
        "tags": [
          "demo"
        ],
        "summary": "Demo page",
        "operationId": "getDemoPage",
        "responses": {
          "200": {
            "$ref": "#/responses/routingGenericResponse"
          }
        }
      }
    },
    "/health": {
      "get": {
        "description": "Returns the health status of the routing service including the number of\nloaded graph nodes.",
        "tags": [
          "health"
        ],
        "summary": "Health check",
        "operationId": "routingHealthCheck",
        "responses": {
          "200": {
            "$ref": "#/responses/routingGenericResponse"
          }
        }
      }
    },
    "/v1/digest-simulator": {
      "get": {
        "description": "Simulates the content of a digest email for a member at a given location,\noptionally grouping results by poster.",
        "tags": [
          "routing"
        ],
        "summary": "Digest email simulator",
        "operationId": "getDigestSimulator",
        "parameters": [
          {
            "type": "number",
            "format": "double",
            "description": "Latitude of member's location",
            "name": "lat",
            "in": "query",
            "required": true
          },
          {
            "type": "number",
            "format": "double",
            "description": "Longitude of member's location",
            "name": "lng",
            "in": "query",
            "required": true
          },
          {
            "type": "boolean",
            "description": "Whether to group results by poster (true/false)",
            "name": "group_by_poster",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/responses/routingGenericResponse"
          },
          "400": {
            "$ref": "#/responses/routingErrorResponse"
          }
        }
      }
    },
    "/v1/fairness": {
      "get": {
        "description": "Computes a fairness-adjusted isochrone that down-weights densely-connected\nareas relative to sparse areas, improving equity of reach estimates.",
        "tags": [
          "routing"
        ],
        "summary": "Fairness-weighted isochrone",
        "operationId": "getFairnessIsochrone",
        "parameters": [
          {
            "type": "number",
            "format": "double",
            "description": "Latitude of origin point",
            "name": "lat",
            "in": "query",
            "required": true
          },
          {
            "type": "number",
            "format": "double",
            "description": "Longitude of origin point",
            "name": "lng",
            "in": "query",
            "required": true
          },
          {
            "type": "number",
            "format": "double",
            "description": "Travel-time budget in minutes (default 15)",
            "name": "minutes",
            "in": "query"
          },
          {
            "type": "number",
            "format": "double",
            "description": "Fairness weighting factor 0–1 (default 0)",
            "name": "fairness",
            "in": "query"
          },
          {
            "type": "string",
            "description": "Travel mode (walk, cycle, drive; default walk)",
            "name": "mode",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/responses/routingGenericResponse"
          },
          "400": {
            "$ref": "#/responses/routingErrorResponse"
          }
        }
      }
    },
    "/v1/groups/nearby": {
      "get": {
        "description": "Returns a GeoJSON FeatureCollection of freegle groups whose area overlaps\nwith or is near the given lat/lng point.",
        "tags": [
          "routing"
        ],
        "summary": "Nearby groups",
        "operationId": "getNearbyGroups",
        "parameters": [
          {
            "type": "number",
            "format": "double",
            "description": "Latitude of query point",
            "name": "lat",
            "in": "query",
            "required": true
          },
          {
            "type": "number",
            "format": "double",
            "description": "Longitude of query point",
            "name": "lng",
            "in": "query",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/responses/routingGenericResponse"
          },
          "400": {
            "$ref": "#/responses/routingErrorResponse"
          }
        }
      }
    },
    "/v1/isochrone": {
      "get": {
        "description": "Computes walk, cycle, and drive isochrone polygons for a given lat/lng point\nand travel-time budget.",
        "tags": [
          "routing"
        ],
        "summary": "Compute isochrone",
        "operationId": "getIsochrone",
        "parameters": [
          {
            "type": "number",
            "format": "double",
            "description": "Latitude of origin point (required)",
            "name": "lat",
            "in": "query",
            "required": true
          },
          {
            "type": "number",
            "format": "double",
            "description": "Longitude of origin point (required)",
            "name": "lng",
            "in": "query",
            "required": true
          },
          {
            "type": "number",
            "format": "double",
            "description": "Travel-time budget in minutes (default 15, max 120)",
            "name": "minutes",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/responses/routingGenericResponse"
          },
          "400": {
            "$ref": "#/responses/routingErrorResponse"
          }
        }
      }
    },
    "/v1/nearby-freeglers": {
      "get": {
        "description": "Computes the isochrone polygon for the origin and returns all freeglers whose\napproximate location falls within it. Results are capped at 2000 points.",
        "tags": [
          "routing"
        ],
        "summary": "Nearby freeglers",
        "operationId": "getNearbyFreeglers",
        "parameters": [
          {
            "type": "number",
            "format": "double",
            "description": "Latitude of origin point",
            "name": "lat",
            "in": "query",
            "required": true
          },
          {
            "type": "number",
            "format": "double",
            "description": "Longitude of origin point",
            "name": "lng",
            "in": "query",
            "required": true
          },
          {
            "type": "number",
            "format": "double",
            "description": "Travel-time budget in minutes (default 15)",
            "name": "minutes",
            "in": "query"
          },
          {
            "type": "string",
            "description": "Travel mode (walk, cycle, drive; default walk)",
            "name": "mode",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/responses/routingGenericResponse"
          },
          "400": {
            "$ref": "#/responses/routingErrorResponse"
          }
        }
      }
    },
    "/v1/posts-for-member": {
      "get": {
        "description": "Returns freegle posts whose origin is reachable within the given travel time\nfrom the member's location, for a given date window.",
        "tags": [
          "routing"
        ],
        "summary": "Posts reachable by a member",
        "operationId": "getPostsForMember",
        "parameters": [
          {
            "type": "number",
            "format": "double",
            "description": "Latitude of member's location",
            "name": "lat",
            "in": "query",
            "required": true
          },
          {
            "type": "number",
            "format": "double",
            "description": "Longitude of member's location",
            "name": "lng",
            "in": "query",
            "required": true
          },
          {
            "type": "number",
            "format": "double",
            "description": "Maximum travel time in minutes",
            "name": "max_minutes",
            "in": "query",
            "required": true
          },
          {
            "type": "string",
            "description": "Date filter (YYYY-MM-DD)",
            "name": "date",
            "in": "query",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/responses/routingGenericResponse"
          },
          "400": {
            "$ref": "#/responses/routingErrorResponse"
          }
        }
      }
    },
    "/v1/ripple-eval": {
      "post": {
        "description": "Accepts a proposed ripple schedule as JSON and returns evaluation metrics.",
        "tags": [
          "routing"
        ],
        "summary": "Evaluate ripple schedule",
        "operationId": "postRippleEval",
        "responses": {
          "200": {
            "$ref": "#/responses/routingGenericResponse"
          },
          "400": {
            "$ref": "#/responses/routingErrorResponse"
          }
        }
      }
    },
    "/v1/ripple-schedule": {
      "get": {
        "description": "Returns a time-bucketed schedule of how many freeglers are reachable at each\ntravel-time step from the origin, used to pace ripple email sends.",
        "tags": [
          "routing"
        ],
        "summary": "Ripple send schedule",
        "operationId": "getRippleSchedule",
        "parameters": [
          {
            "type": "number",
            "format": "double",
            "description": "Latitude of origin point",
            "name": "lat",
            "in": "query",
            "required": true
          },
          {
            "type": "number",
            "format": "double",
            "description": "Longitude of origin point",
            "name": "lng",
            "in": "query",
            "required": true
          },
          {
            "type": "integer",
            "description": "Number of time steps (default 30)",
            "name": "ticks",
            "in": "query"
          },
          {
            "type": "number",
            "format": "double",
            "description": "Maximum travel time in minutes (default 30)",
            "name": "max_minutes",
            "in": "query"
          },
          {
            "type": "string",
            "description": "Send-curve shape (e.g. step-70; default step-70)",
            "name": "curve",
            "in": "query"
          },
          {
            "type": "string",
            "description": "Travel mode (walk, cycle, drive; default drive)",
            "name": "mode",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/responses/routingGenericResponse"
          },
          "400": {
            "$ref": "#/responses/routingErrorResponse"
          }
        }
      }
    }
  },
  "responses": {
    "routingErrorResponse": {
      "description": "routingErrorResponse is a JSON error response"
    },
    "routingGenericResponse": {
      "description": "routingGenericResponse is a generic JSON response"
    }
  }
}