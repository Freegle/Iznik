<?xml version="1.0" encoding="utf-8"?>
<!-- Backup/transfer rules for Android 12+ (backup_rules.xml covers 11 and
     below). Same exclusions, same reason: a restored Firebase Installation ID
     resurrects the previous install's FCM token, which is already dead, and
     the app silently re-registers it instead of minting a fresh one. Applies
     to both cloud restore and device-to-device transfer (Smart Switch etc.). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml"/>
        <exclude domain="sharedpref" path="com.google.firebase.messaging.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml"/>
        <exclude domain="sharedpref" path="com.google.firebase.messaging.xml"/>
    </device-transfer>
</data-extraction-rules>
