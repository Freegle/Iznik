{
  "id": "freegle-automod",
  "name": "Freegle automated review",
  "version": "4",
  "description": "Fact and text checks that decide whether a Pending post can be approved automatically (plans/active/automod-flowchart.md).",
  "initialState": "START",
  "states": {
    "START": {
      "description": "Entry point. Immediately continues to the first check.",
      "nodeType": "start"
    },
    "VETO": {
      "description": "Is there a reason on record to look at this member's posts?",
      "nodeType": "tool",
      "check": {
        "kind": "fact",
        "fact": "member_veto"
      }
    },
    "HOLD_VETO": {
      "description": "There is a reason on record to look at this member's posts: a moderator note, a rejected post, a spam mark or an open membership review.",
      "nodeType": "end"
    },
    "MODERATED": {
      "description": "Has a moderator given this member a posting status?",
      "nodeType": "tool",
      "check": {
        "kind": "fact",
        "fact": "member_moderated"
      }
    },
    "HOLD_MODERATED": {
      "description": "This member has a posting status set by a moderator, so their posts wait for a moderator.",
      "nodeType": "end"
    },
    "GROUP_CLOSED": {
      "description": "Does this community have every post checked by a moderator, or is it closed?",
      "nodeType": "tool",
      "check": {
        "kind": "fact",
        "fact": "group_disallows"
      }
    },
    "HOLD_GROUP_CLOSED": {
      "description": "This community has every post checked by a moderator, or is closed.",
      "nodeType": "end"
    },
    "NO_LOCATION": {
      "description": "Is this post missing a location?",
      "nodeType": "tool",
      "check": {
        "kind": "fact",
        "fact": "no_location"
      }
    },
    "HOLD_NO_LOCATION": {
      "description": "This post has no location.",
      "nodeType": "end"
    },
    "OUTSIDE_UK": {
      "description": "Is this post's location outside the UK?",
      "nodeType": "tool",
      "check": {
        "kind": "fact",
        "fact": "outside_uk"
      }
    },
    "HOLD_OUTSIDE_UK": {
      "description": "This post's location is outside the UK.",
      "nodeType": "end"
    },
    "DUPLICATE": {
      "description": "Is this a duplicate of the member's own open post, or a repost sooner than this community allows?",
      "nodeType": "tool",
      "check": {
        "kind": "fact",
        "fact": "duplicate"
      }
    },
    "HOLD_DUPLICATE": {
      "description": "Looks like a duplicate or an early repost of the member's own post.",
      "nodeType": "end"
    },
    "SPAM_SIGNAL": {
      "description": "Does this post show signs of spam?",
      "nodeType": "tool",
      "check": {
        "kind": "fact",
        "fact": "spam_signal"
      }
    },
    "HOLD_SPAM_SIGNAL": {
      "description": "This post shows signs of spam.",
      "nodeType": "end"
    },
    "PERSONAL_INFO": {
      "description": "Does this post contain personal information such as a phone number or address?",
      "nodeType": "tool",
      "check": {
        "kind": "fact",
        "fact": "personal_info"
      }
    },
    "HOLD_PERSONAL_INFO": {
      "description": "This post contains personal information such as a phone number or address.",
      "nodeType": "end"
    },
    "LANGUAGE": {
      "description": "Is this post written in a language other than English?",
      "nodeType": "tool",
      "check": {
        "kind": "fact",
        "fact": "not_english"
      }
    },
    "HOLD_LANGUAGE": {
      "description": "This post is not in English.",
      "nodeType": "end"
    },
    "VAGUE": {
      "description": "Is this post too vague to publish automatically?",
      "nodeType": "tool",
      "check": {
        "kind": "fact",
        "fact": "vague"
      }
    },
    "HOLD_VAGUE": {
      "description": "This post is too vague to publish automatically.",
      "nodeType": "end"
    },
    "VAGUE_TEXT": {
      "description": "Is it too vague to tell what is offered or wanted?",
      "nodeType": "tool",
      "check": {
        "kind": "text",
        "question": "Freegle asks members to name the items they want, for example \"a sofa, a cooker or a bed\". Is this post a general request that names no specific item - such as \"anything\", \"various\", \"any dog items\", or a single broad category like \"furniture\" or \"electrical\" - or, for an offer, is it unclear what is being given?",
        "threshold": 0.7
      }
    },
    "HOLD_VAGUE_TEXT": {
      "description": "Too vague: Freegle asks members to name the items they want. Ask the member to say what the item is.",
      "nodeType": "end"
    },
    "NOT_AN_ITEM": {
      "description": "Is it about something other than an item?",
      "nodeType": "tool",
      "check": {
        "kind": "text",
        "question": "Freegle posts must offer or ask for physical items, to keep them out of landfill. Is this post about something else - a service, job, event, lift, room, help, a question or general chat - rather than a physical item? Tickets and vouchers are covered by another question, so answer no for those.",
        "threshold": 0.7
      }
    },
    "HOLD_NOT_AN_ITEM": {
      "description": "This post is not offering or requesting a physical item.",
      "nodeType": "end"
    },
    "SELLING": {
      "description": "Does it ask for or offer money?",
      "nodeType": "tool",
      "check": {
        "kind": "text",
        "question": "Everything on Freegle must be given entirely free, with no strings. Does this post ask for or offer money in any form - a price, \"ono\", a \"donation\" to the poster, or payment for delivery, fuel or postage?",
        "threshold": 0.7
      }
    },
    "HOLD_SELLING": {
      "description": "Asks for or offers money - everything on Freegle must be given entirely free.",
      "nodeType": "end"
    },
    "LOAN": {
      "description": "Is it a loan or a request to borrow?",
      "nodeType": "tool",
      "check": {
        "kind": "text",
        "question": "Is this post asking to borrow something, or offering to lend something?",
        "threshold": 0.7,
        "rule": "allowloans"
      }
    },
    "HOLD_LOAN": {
      "description": "Asks to borrow - this community does not allow loans.",
      "nodeType": "end"
    },
    "SWAP": {
      "description": "Does it ask for something in exchange?",
      "nodeType": "tool",
      "check": {
        "kind": "text",
        "question": "Is the poster asking for something in exchange - another item, a favour or work - rather than giving or asking freely?",
        "threshold": 0.7
      }
    },
    "HOLD_SWAP": {
      "description": "Asks for something in exchange - posts on Freegle must be free.",
      "nodeType": "end"
    },
    "ANIMALS_OFFER": {
      "description": "Is it offering a live animal?",
      "nodeType": "tool",
      "check": {
        "kind": "text",
        "question": "Is this post offering a live animal, such as a pet or livestock, for rehoming?",
        "threshold": 0.7,
        "rule": "animalsoffer",
        "when": "is_offer"
      }
    },
    "HOLD_ANIMALS_OFFER": {
      "description": "Offers an animal - this community does not allow animals to be offered this way.",
      "nodeType": "end"
    },
    "ANIMALS_WANTED": {
      "description": "Is it asking for a live animal?",
      "nodeType": "tool",
      "check": {
        "kind": "text",
        "question": "Is this post asking for a live animal, such as a pet or livestock?",
        "threshold": 0.7,
        "rule": "animalswanted",
        "when": "is_wanted"
      }
    },
    "HOLD_ANIMALS_WANTED": {
      "description": "Asks for an animal - this community does not allow animals to be requested this way.",
      "nodeType": "end"
    },
    "WEAPONS": {
      "description": "Is this post about a weapon?",
      "nodeType": "tool",
      "check": {
        "kind": "text",
        "question": "Is this post about a weapon?",
        "threshold": 0.7,
        "rule": "weapons"
      }
    },
    "HOLD_WEAPONS": {
      "description": "Mentions a weapon - this community does not allow weapons.",
      "nodeType": "end"
    },
    "FIREARMS": {
      "description": "Is this post about a firearm or ammunition?",
      "nodeType": "tool",
      "check": {
        "kind": "text",
        "question": "Is this post about a firearm or ammunition?",
        "threshold": 0.7,
        "rule": "firearms"
      }
    },
    "HOLD_FIREARMS": {
      "description": "Mentions a firearm - this community does not allow firearms.",
      "nodeType": "end"
    },
    "KNIVES": {
      "description": "Is it about knives?",
      "nodeType": "tool",
      "check": {
        "kind": "text",
        "question": "Is this post about a knife or other bladed item, other than ordinary cutlery?",
        "threshold": 0.7,
        "rule": "knives"
      }
    },
    "HOLD_KNIVES": {
      "description": "Mentions a knife or bladed weapon - this community does not allow them.",
      "nodeType": "end"
    },
    "MEDICINE": {
      "description": "Is it about prescription medicine?",
      "nodeType": "tool",
      "check": {
        "kind": "text",
        "question": "Is this post about prescription medicine?",
        "threshold": 0.7,
        "rule": "medicationsprescription"
      }
    },
    "HOLD_MEDICINE": {
      "description": "Prescription medicine - this community does not allow it.",
      "nodeType": "end"
    },
    "MEDICINE_OTC": {
      "description": "Is it about non-prescription medicine or supplements?",
      "nodeType": "tool",
      "check": {
        "kind": "text",
        "question": "Is this post about medicine you can buy without a prescription, or health supplements such as vitamins or nutritional drinks?",
        "threshold": 0.7,
        "rule": "medicationsotc"
      }
    },
    "HOLD_MEDICINE_OTC": {
      "description": "Non-prescription medicine or supplements - this community does not allow them.",
      "nodeType": "end"
    },
    "MEDICINE_ANIMAL": {
      "description": "Is it about medicine for animals?",
      "nodeType": "tool",
      "check": {
        "kind": "text",
        "question": "Is this post about medicine or treatments for animals, such as flea or worming treatments?",
        "threshold": 0.7,
        "rule": "medicationsanimals"
      }
    },
    "HOLD_MEDICINE_ANIMAL": {
      "description": "Medicine for animals - this community does not allow it.",
      "nodeType": "end"
    },
    "CONTACT_LENSES": {
      "description": "Is it about contact lenses?",
      "nodeType": "tool",
      "check": {
        "kind": "text",
        "question": "Is this post about contact lenses?",
        "threshold": 0.7,
