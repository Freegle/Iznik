      "check": {
        "kind": "text",
        "question": "Is this post about contact lens solution?",
        "threshold": 0.7,
        "rule": "contactlensessolutions"
      }
    },
    "HOLD_LENS_SOLUTION": {
      "description": "Contact lens solution - this community does not allow it.",
      "nodeType": "end"
    },
    "ALCOHOL": {
      "description": "Is this post about alcohol?",
      "nodeType": "tool",
      "check": {
        "kind": "text",
        "question": "Is this post about alcohol?",
        "threshold": 0.7,
