# Freegle Batch Base Image
# Contains compiled PHP extensions, PECL packages, and MJML — the slow build steps.
# Rebuild only when PHP version, extension list, or MJML version changes.
# Built via GitHub Actions → pushed to ghcr.io/freegle/freegle-batch-base:latest
# Cached on the Katapult cache server GHCR mirror (185.44.254.6:5001).
#
# To rebuild manually:
#   docker build -f iznik-batch/docker/Dockerfile.base -t ghcr.io/freegle/freegle-batch-base:latest iznik-batch/

# syntax=docker/dockerfile:1
FROM php:8.4-cli

# System dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libwebp-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    libgmp-dev \
    libicu-dev \
    libpq-dev \
    zip \
    unzip \
    supervisor \
    default-mysql-client \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# GD with JPEG/PNG/WebP support
RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp

# PHP extensions (compiled from source — the slow step)
RUN docker-php-ext-install \
    pdo_mysql \
    pdo_pgsql \
    mbstring \
    exif \
    pcntl \
    bcmath \
    gmp \
    zip \
    intl \
    gd

# PECL extensions (compiled from source — also slow)
RUN pecl install redis pcov && docker-php-ext-enable redis pcov

# PHP memory limit for PCOV coverage tracking
RUN echo "memory_limit=1024M" >> /usr/local/etc/php/conf.d/memory-limit.ini

# Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Node.js 20 for MJML
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# MJML email template compiler
RUN --mount=type=cache,target=/root/.npm \
    npm install -g mjml
