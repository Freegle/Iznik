# =============================================================================
# Background Services Environment Template
# =============================================================================
# Copy this file to .env.background and fill in the actual values.
# The .env.background file is gitignored and should never be committed.
#
# Used by: batch-prod (and future background services)
# =============================================================================

# Laravel Application Key (generate with: php artisan key:generate --show)
APP_KEY=base64:GENERATE_A_NEW_KEY_HERE

# =============================================================================
# Database Configuration
# =============================================================================
# Production database server IP address (the single Galera WRITE node).
DB_HOST_IP=10.x.x.x
# Optional read-replica IP for the read/write split. Leave blank to send all
# reads to DB_HOST_IP (single-host behaviour). Writes always go to DB_HOST_IP.
DB_HOST_READ_IP=
# Database password
DB_PASSWORD=your_database_password_here

# =============================================================================
# Mail Configuration
# =============================================================================
# SMTP smarthost IP address for outgoing mail
MAIL_HOST_IP=10.x.x.x

# =============================================================================
# AMP Email Configuration
# =============================================================================
# Secret for AMP email token signing
AMP_SECRET=your_amp_secret_here

# =============================================================================
# Error Tracking
# =============================================================================
# Sentry DSN for error reporting (leave empty to disable)
SENTRY_LARAVEL_DSN=

# =============================================================================
# Firebase Cloud Messaging (Push Notifications)
# =============================================================================
# Path to Firebase service account credentials JSON file on the HOST.
# This file is mounted read-only into the container at /etc/firebase.json.
# Copy from the production server: scp bulk3:/etc/firebase.json /path/to/firebase.json
#
# IMPORTANT: this var is named FIREBASE_HOST_PATH (not _CREDENTIALS_PATH),
# because Laravel reads FIREBASE_CREDENTIALS_PATH at runtime to find the
# creds INSIDE the container (where the file is always /etc/firebase.json).
# If we used one shared name, .env.background would leak the host path into
# the container's environment and Laravel would try to open it inside the
# container — silently disabling push (memory
# project_push_dropped_devnull_firebase, 06-03 → 06-06 outage).
FIREBASE_HOST_PATH=/path/to/firebase.json

# =============================================================================
# Git Summary (Weekly Code Changes Report)
# =============================================================================
# Google Gemini API key for AI summarization
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Discourse email address for posting summaries (email-to-forum)
FREEGLE_DISCOURSE_TECH_EMAIL=tech-updates@discourse.ilovefreegle.org

# Discourse REST API — required by discourse:check-users / discourse:not-signed-up.
# Both commands skip silently if DISCOURSE_APIKEY is blank.
DISCOURSE_URL=https://discourse.ilovefreegle.org
DISCOURSE_APIKEY=
DISCOURSE_API_USERNAME=system
DISCOURSE_ANNOUNCEMENTS_ID=7

# PayPal NVP API — required by the donations:paypal-download fallback. Skips if blank.
PAYPAL_USERNAME=
PAYPAL_PASSWORD=
PAYPAL_SIGNATURE=
PAYPAL_NVP_ENDPOINT=https://api-3t.paypal.com/nvp
PAYPAL_DOWNLOAD_DAYS=30

# Central mods / Volunteer Support address — receives the Discourse reports.
FREEGLE_CENTRALMODS_ADDR=volunteersupport@ilovefreegle.org


# =============================================================================
# Cloudflare Workers AI (Flux Schnell image generation)
# =============================================================================
# Account ID: dashboard right sidebar, or URL fragment after /accounts/
# API token: dashboard → My Profile → API Tokens → Create Token
#            with permission "Workers AI: Read" on the account.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_AI_TOKEN=your_cloudflare_workers_ai_token_here

# =============================================================================
# PostgreSQL / PostGIS (Postcode Remapping)
# =============================================================================
# PostgreSQL server with PostGIS extension for efficient KNN postcode-to-area mapping.
PGSQL_HOST=10.x.x.x
PGSQL_PORT=5432
PGSQL_USERNAME=iznik
PGSQL_PASSWORD=your_pgsql_password_here

# =============================================================================
# WhatJobs XML feeds (integrations:sync-whatjobs)
# =============================================================================
# V1 equivalents in /etc/iznik.conf: WHATJOBS_DUMP / WHATJOBS_DUMP2
WHATJOBS_FEED1=https://feeds.whatjobs.com/freegle/freegle_en_GB.xml.gz
WHATJOBS_FEED2=https://clickcastfeeds.s3.amazonaws.com/<account-id>/feed.xml.gz

# =============================================================================
# Daily-digest cutover allowlist
# =============================================================================
# Comma-separated list of email addresses to which `mail:digest:unified
# --mode=daily` is allowed to send during phased go-live. Anyone not on the
# list is silently skipped. Unset (or empty) means "no restriction — send to
# all eligible users". Remove this line once the daily-digest cutover is
# complete and you want to send to everyone.
# FREEGLE_DIGEST_DAILY_ALLOWLIST=edward@ehibbert.org.uk

# =============================================================================
# Donation email recipients
# =============================================================================
# Two distinct donation emails go to two distinct addresses:
#   - mail:donations:summary    (hourly status table of donations that landed)
#                               -> FREEGLE_FUNDRAISING_ADDR
#   - mail:donations:thank-prep (daily card-per-donation digest for composing
#                               thank-you replies) -> FREEGLE_THANKS_ADDR
# IMPORTANT: FREEGLE_THANKS_ADDR falls back to FREEGLE_FUNDRAISING_ADDR when
# unset (see config/freegle.php). So if you only set the fundraising address,
# the daily thanks digest ALSO lands there. Set both to route them separately.
FREEGLE_FUNDRAISING_ADDR=log@ehibbert.org.uk
FREEGLE_THANKS_ADDR=info@ilovefreegle.org

# Recipient of the monthly LoveJunk/TrashNothing invoice request (V1: TN_ADDR).
# Required for lovejunk:send-tn-invoice to actually send; if unset the command
# computes the split but silently sends nothing. Partner contact - get from prod.
FREEGLE_TN_INVOICE_ADDR=
# Treasurer address quoted in the invoice body (V1: TREASURER_ADDR).
FREEGLE_TREASURER_ADDR=treasurer@ilovefreegle.org

# GeoLite2-Country database path for iznik-batch fromcountry lookups.
# Refreshed weekly by scripts/geoip-update.sh (host cron, creds in /etc/GeoIP.conf).
# Falls back to the bundled resources/geoip copy if unset/missing.
GEOIP_MMDB_PATH=/var/www/html/storage/app/geoip/GeoLite2-Country.mmdb
