# xample MySQL config file for very large systems.
#
# This is for a large system with memory of 1G-2G where the system runs mainly
# MySQL.
#
# MySQL programs look for option files in a set of
# locations which depend on the deployment platform.
# You can copy this option file to one of those
# locations. For information about these locations, see:
# http://dev.mysql.com/doc/mysql/en/option-files.html
#
# In this file, you can use all long options that a program supports.
# If you want to know which options a program supports, run the program
# with the "--help" option.

# The following options will be passed to all MySQL clients
[client]
#password	= __REDACTED__
#port		= 3307
socket		= /var/run/mysqld/mysqld.sock

# Here follows entries for some specific programs

# The MySQL server
[mysqld]
# Disable persistent stats to work around crash - see https://bugs.mysql.com/bug.php?id=84940 and
# https://bugs.launchpad.net/percona-server/+bug/1664519
innodb-stats-persistent             = 0
innodb_lru_scan_depth = 128
innodb-stats-transient-sample-pages = 20
innodb-stats-auto-recalc            = 0

pid-file    = /var/run/mysqld/mysqld.pid
sql_mode = "NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"
open_files_limit = 1000000
#innodb_force_recovery = 4
innodb_compression_level = 9
tc_heuristic_recover = COMMIT
datadir=/var/lib/mysql
max_connections = 10000
max_connect_errors = 10000
innodb_stats_on_metadata = 0
# We listen on the internal address, and also IPv6.  IPv6 is only used by the backup server.
#bind-address = __IP__,__IPV6__,127.0.0.1
# IP v6 address is disabled as we're having issues with Google.
bind-address = __IP__,127.0.0.1
#bind-address    = *
port		= 3306
socket		= /var/run/mysqld/mysqld.sock
skip-external-locking
#key_buffer_size = 384M
max_allowed_packet = 32M
table_open_cache = 10000
table_definition_cache = 10000
sort_buffer_size = 2M
read_buffer_size = 2M
read_rnd_buffer_size = 8M
myisam_sort_buffer_size = 64M
thread_cache_size = 200
expire_logs_days = 7
join_buffer_size = 256K
wait_timeout = 600
event_scheduler=on
disable_log_bin
pxc-encrypt-cluster-traffic=OFF
log-error = /var/lib/mysql/db1.log

# Don't listen on a TCP/IP port at all. This can be a security enhancement,
# if all processes that need to connect to mysqld run on the same host.
# All interaction with mysqld must be made via Unix sockets or named pipes.
# Note that using this option without enabling named pipes on Windows
# (via the "enable-named-pipe" option) will render mysqld useless!
# 
#skip-networking

# Binary logging not required for a cluster unless you want PITR, so
# disable it to save disk space.
#log-bin=mysql-bin
#max_binlog_files=3

# required unique id between 1 and 2^32 - 1
# defaults to 1 if master-host is not set
# but will not function as a master if omitted
server-id	= 22

# Replication Slave (comment out master section to use this)
#
# To configure this host as a replication slave, you can choose between
# two methods :
#
# 1) Use the CHANGE MASTER TO command (fully described in our manual) -
#    the syntax is:
#
#    CHANGE MASTER TO MASTER_HOST=<host>, MASTER_PORT=<port>,
#    MASTER_USER=<user>, MASTER_PASSWORD=__REDACTED__ ;
#
#    where you replace <host>, <user>, <password> by quoted strings and
#    <port> by the master's port number (3306 by default).
#
#    Example:
#
#    CHANGE MASTER TO MASTER_HOST='__IP__', MASTER_PORT=3306,
#    MASTER_USER='joe', MASTER_PASSWORD=__REDACTED__
#
# OR
#
# 2) Set the variables below. However, in case you choose this method, then
#    start replication for the first time (even unsuccessfully, for example
#    if you mistyped the password in master-password and the slave fails to
#    connect), the slave will create a master.info file, and any later
#    change in this file to the variables' values below will be ignored and
#    overridden by the content of the master.info file, unless you shutdown
#    the slave server, delete master.info and restart the slaver server.
#    For that reason, you may want to leave the lines below untouched
#    (commented) and instead use CHANGE MASTER TO (see above)
#
# required unique id between 2 and 2^32 - 1
# (and different from the master)
# defaults to 2 if master-host is set
# but will not function as a slave if omitted
#server-id       = 2
#
# The replication master for this slave - required
#master-host     =   <hostname>
#
# The username the slave will use for authentication when connecting
# to the master - required
#master-user     =   <username>
#
# The password the slave will authenticate with when connecting to
# the master - required
#master-password =   __REDACTED__
#
# The port the master is listening on.
# optional - defaults to 3306
#master-port     =  <port>
#
# binary logging - not required for slaves, but recommended
#log-bin=mysql-bin
#
# binary logging format - mixed recommended 
#binlog_format=mixed

# Uncomment the following if you are using InnoDB tables
innodb_data_home_dir = /var/lib/mysql
innodb_data_file_path = ibdata1:2000M;ibdata2:10M:autoextend
innodb_log_group_home_dir = /var/lib/mysql
# You can set .._buffer_pool_size up to 50 - 80 %
# of RAM but beware of setting memory usage too high
#innodb_buffer_pool_size = 384M
innodb_buffer_pool_size = 6G
innodb_buffer_pool_instances = 16
innodb_log_file_size = 320M
innodb_log_buffer_size = 8M
# Set to 0 for systems with more than one node in the cluster
innodb_flush_log_at_trx_commit = 0
innodb_lock_wait_timeout = 50
innodb_read_io_threads = 16
innodb_write_io_threads = 16
innodb_flush_neighbors = 0

# Galera
wsrep_provider=/usr/lib/libgalera_smm.so
#wsrep_cluster_address=gcomm://__IP__,__IP__,__IP__,__IP__,__IP__,__IP__
wsrep_cluster_address=gcomm://__IP__,__IP__,__IP__
wsrep_cluster_name = freegle
wsrep_sst_method=xtrabackup-v2
wsrep_provider_options = "evs.suspect_timeout=PT10S; evs.inactive_timeout=PT25S; evs.auto_evict=0; evs.version=1;gcache.keep_pages_count=4;gcache.size=2G;gcache.recover=yes;"
wsrep_max_ws_size = 1G
wsrep_retry_autocommit = 5
#wsrep_sst_donor=db-2.ilovefreegle.org,db-3.ilovefreegle.org # Users should be using db3 so SST from db2
#
# Experimenting with multiple slave threads
wsrep_slave_threads = 4
innodb_autoinc_lock_mode = 2

# We see transaction hangups.
kill_idle_transaction = 60

# In order for Galera to work correctly binlog format should be ROW
binlog_format=ROW
# MyISAM storage engine has only experimental support
default_storage_engine=InnoDB
# This changes how |InnoDB| autoincrement locks are managed and is a requirement for Galera
innodb_autoinc_lock_mode=2

# Disable AHI which may be causing deadlocks (doesn't seem to have helped, though).
innodb_adaptive_hash_index=off

# Limit thread concurrency.  Possible that many clients are causing InnoDB thrashing.
innodb_thread_concurrency = 250

# Sort buffer size errors
sort_buffer_size = 256000000

# Allow local uploads for jobs
local_infile = 1;

[mysqldump]
quick
max_allowed_packet = 500M

[mysql]
no-auto-rehash
# Remove the next comment character if you are not familiar with SQL
#safe-updates

[myisamchk]
#key_buffer_size = 256M
sort_buffer_size = 256M
read_buffer = 2M
write_buffer = 2M

[mysqlhotcopy]
interactive-timeout
