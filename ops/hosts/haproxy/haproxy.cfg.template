global
  log 127.0.0.1 local0
  maxconn 100000
  daemon
  uid 99
  gid 99
  lua-load /etc/haproxy/lua/rate_delay.lua
  tune.lua.maxmem 64

defaults
  log     global
  timeout connect 5000
  timeout client 50000
  timeout server 50000
  maxconn 100000
  fullconn 100000

frontend http_frontend
  bind *:80
  mode http

  # Check for LetsEncrypt challenge
  acl path_certbot path_beg /.well-known/acme-challenge/

  # Redirect http to https unless it's certbot
  http-request redirect scheme https unless { ssl_fc } || path_certbot

  # Use the built-in web server to serve the certbot challenge
  use_backend letsencrypt-backend if path_certbot

frontend https_frontend
  mode http

  bind *:443 ssl crt-list /etc/haproxy/haproxy.crtlist alpn h2,http/1.1

  # Define ACLs early so we can use them for rate limit exemptions.
  acl new_modtools hdr(host) -i modtools.org
  acl new_modtools hdr(host) -i new.modtools.org

  # HAProxy-generated errors (504 timeout server, 503 no-server, 429 deny)
  # bypass http-response rules and the Go API's own CORS headers, so
  # cross-origin browsers (modtools.org -> api.ilovefreegle.org) surface them
  # as opaque "Failed to fetch" network errors. Clients then retry expensive
  # requests up to 10x (the single-retry-on-504 guard in iznik-nuxt3 9d12fcc5c
  # never sees the 504), stacking heavyweight queries on the DB.
  # http-after-response DOES run on internally generated responses; only add
  # the header when the response does not already carry one.
  http-after-response set-header Access-Control-Allow-Origin "*" if { var(txn.isapi) -m found } !{ res.hdr(Access-Control-Allow-Origin) -m found }
  acl api_path path_beg -i /api
  acl api_host hdr(host) -i api.ilovefreegle.org

  # Extract loggedInAs user ID from query string for per-user rate limiting.
  # This sets X-User-Id header so the Lua script can identify the user.
  http-request set-var(txn.userid) url_param(loggedInAs)
  http-request set-header X-User-Id %[var(txn.userid)] if { var(txn.userid) -m found }
  acl has_userid var(txn.userid) -m found

  # Rate limit based on IP with graduated delays (sc0 - fallback for anonymous).
  # Uses shared stick-table in backend 'per_ip_rates' so the per-IP counter
  # is the same whether the client hits :443 or :8192.
  # Only track API requests - static assets don't need rate limiting.
  http-request track-sc0 src table per_ip_rates if api_path || api_host

  # Per-user rate limiting (sc1 - for logged-in users).
  # Uses stick table defined in backend 'per_user_rates'.
  # This catches abusive users even if they share IPs with others.
  http-request track-sc1 var(txn.userid) table per_user_rates if has_userid api_path or has_userid api_host

  # Calculate delay based on rate (Lua script).
  # Delays: 0ms at <=10 req/s, scaling to 3000ms at 30+ req/s.
  # Lua will use sc1 (per-user) for logged-in users, sc0 (per-IP) otherwise.
  http-request lua.rate_check if api_path || api_host

  # Mark API traffic so http-after-response (which runs on HAProxy-generated
  # responses too, unlike http-response) can scope the CORS header below.
  http-request set-var(txn.isapi) int(1) if api_path || api_host

  # Hard reject only at extreme rates (safety valve for broken/malicious clients).
  # Only applies to API requests - static assets are exempt.
  acl is_privileged var(txn.rate_privileged) -m int gt 0

  # Per-user hard limit: 100 req/s per logged-in user (safety valve)
  http-request deny deny_status 429 if { sc1_http_req_rate gt 100 } has_userid api_path !is_privileged
  http-request deny deny_status 429 if { sc1_http_req_rate gt 100 } has_userid api_host !is_privileged

  # Per-IP hard limit: 200 req/s (fallback for anonymous or as absolute cap)
  http-request deny deny_status 429 if { sc0_http_req_rate gt 200 } api_path !is_privileged
  http-request deny deny_status 429 if { sc0_http_req_rate gt 200 } api_host !is_privileged

  # ModTools is now on Netlify, as a branch deployment of the ILF site.  We can't manage to get certificates working on there,
  # but we can proxy to it from here.
  # NOTE: haproxy evaluates ALL http-request rules before ANY use_backend, so
  # these sit above the routing rules: config order now matches execution order.
  # Relative order among http-request rules is unchanged (rate-limiting above,
  # then the shortlink rewrite, then the old-domain redirects).
  acl shortlink_host hdr(host) -i freegle.in www.freegle.in freegle.it www.freegle.it frgl.it www.frgl.it
  http-request set-path /shortlink?name=%[path,regsub(^/,,)] if shortlink_host

  # Old-domain 302 redirects, migrated off app1 (were falling through to
  # default_backend → app1's redirect_* vhosts). Terminated here at HAProxy so
  # app1 carries no live HTTP traffic. Path-preserving via `redirect prefix`.
  # fdnuxt.ilovefreegle.org + shared.ilovefreegle.org dropped — no cert in the
  # crtlist (already TLS-broken + unused, same call as cdn).
  acl redir_ilf hdr(host) -i direct.ilovefreegle.org directv2.ilovefreegle.org dev.ilovefreegle.org freegle.org.uk www.freegle.org.uk ilovefreegle.org lovefreegle.org www.lovefreegle.org
  http-request redirect prefix https://www.ilovefreegle.org code 302 if redir_ilf
  acl redir_mt hdr(host) -i dev.modtools.org www.modtools.org
  http-request redirect prefix https://modtools.org code 302 if redir_mt
  acl redir_norfolk hdr(host) -i norfolkfreegle.org www.norfolkfreegle.org
  http-request redirect location https://ilovefreegle.org/norfolk code 302 if redir_norfolk

  use_backend modtools_netlify_backend if new_modtools !api_path
  # AI support helper: modtools.org/api/ai-support/* -> FD host container.
  # Same-origin for ModTools; Support/Admin JWT is enforced by the service.
  acl ai_support_path path_beg -i /api/ai-support
  use_backend ai_support_backend if new_modtools ai_support_path

  # The uploader requires a different backend and headers, so spot if we're accessing that.
  #
  # If also doesn't work unless we disable http-buffer-request
  acl uploader hdr(host) -i uploads.ilovefreegle.org
  use_backend tusd_backend if uploader
  no option http-buffer-request

  # Redirect any requests to the API to the API backend.  This allows us to access the API over port 443 as well as 8192, which helps
  # in some firewall scenarios.
  acl api_request hdr(host) -i api.ilovefreegle.org
  # Shortlink domains — rewrite path and send to Go API
  use_backend api_server_backend if shortlink_host
  use_backend api_server_backend if api_request


  acl delivery hdr(host) -i delivery.ilovefreegle.org
  use_backend delivery_backend if delivery

  # images.ilovefreegle.org (legacy V1 img_ rewrites, now → apiv2 /image) and
  # users.ilovefreegle.org (bare 302 → www) migrated off app1 to the edge front
  # door (migration plan step 4). Both vhosts live on frontend-nginx; app1 kept
  # as backup during soak. cdn.ilovefreegle.org deliberately NOT migrated
  # (broken + unused — only in old email fixtures).
  acl legacy_images hdr(host) -i images.ilovefreegle.org
  acl legacy_users  hdr(host) -i users.ilovefreegle.org
  use_backend edge_legacy_backend if legacy_images
  use_backend edge_legacy_backend if legacy_users


  # Backend web servers are accessed over http, so that SSL termination/renewal happens on this server.
  acl spatial_host hdr(host) -i spatial.ilovefreegle.org
  use_backend spatial_backend if spatial_host
  default_backend http_backend

backend http_backend
  mode http
  balance leastconn
  stick-table type ip size 200k expire 30m
  stick on src
  option redispatch

  # Apply graduated delay on response for heavy users.
  http-response lua.rate_delay

  http-response del-header Access-Control-Allow-Origin
  http-response set-header Access-Control-Allow-Origin "*"

# Use one server preferentially because that increases cache hits while preserving resilience.

# delivery.ilovefreegle.org — migrated to the edge host (freegledocker /
# frontend-nginx on __IP__:8180, proxy_protocol). app1 kept as backup for
# instant rollback + warm failover (shared NFS; each has its own wsrv cache).
# Mirrors http_backend_cache's options (leastconn/stick-on-src/redispatch);
# send-proxy because frontend-nginx's :80 listener is proxy_protocol.
backend delivery_backend
  mode http
  balance leastconn
  stick-table type ip size 200k expire 30m
  stick on src
  option redispatch
  server edge __IP_edge__:8180 send-proxy check

# images.ilovefreegle.org + users.ilovefreegle.org — migrated off app1 to the
# edge front door (frontend-nginx on __IP__:8180, proxy_protocol). Same
# container/listener as delivery_backend; a separate backend keeps the concerns
# (and the eventual app1-backup removal) independent. app1:80 serves the old V1
# images vhost + users redirect as warm backup during the soak.
backend edge_legacy_backend
  mode http
  balance leastconn
  stick-table type ip size 200k expire 30m
  stick on src
  option redispatch
  server edge __IP_edge__:8180 send-proxy check

frontend api_server_frontend
  bind *:8192 ssl crt /etc/haproxy/api.ilovefreegle.org.pem alpn h2,http/1.1
  mode http

  # Extract loggedInAs user ID from query string for per-user rate limiting.
  http-request set-var(txn.userid) url_param(loggedInAs)
  http-request set-header X-User-Id %[var(txn.userid)] if { var(txn.userid) -m found }
  acl has_userid var(txn.userid) -m found

  # Rate limit based on IP with graduated delays (sc0 - fallback).
  # Uses shared stick-table in backend 'per_ip_rates' so the per-IP counter
  # is the same whether the client hits :443 or :8192.
  http-request track-sc0 src table per_ip_rates

  # Per-user rate limiting (sc1 - for logged-in users).
  # Uses stick table defined in backend 'per_user_rates'.
  http-request track-sc1 var(txn.userid) table per_user_rates if has_userid

  http-request lua.rate_check

  # Per-user hard limit: 100 req/s (safety valve)
  acl is_privileged var(txn.rate_privileged) -m int gt 0
  http-request deny deny_status 429 if { sc1_http_req_rate gt 100 } has_userid !is_privileged
  # Per-IP hard limit: 200 req/s (matches https_frontend so same backend has same ceiling)
  http-request deny deny_status 429 if { sc0_http_req_rate gt 200 } !is_privileged

  # CORS on HAProxy-generated errors (see https_frontend for rationale).
  http-after-response set-header Access-Control-Allow-Origin "*" unless { res.hdr(Access-Control-Allow-Origin) -m found }

  # Check for LetsEncrypt challenge
  acl letsencrypt-acl path_beg /.well-known/acme-challenge/
  use_backend letsencrypt-backend if letsencrypt-acl

  # Otherwise...
  default_backend api_server_backend

backend api_server_backend
  mode http
  balance leastconn

  # Sysadmin rippling analytics runs ~60s of serial SQL until the parallelised
  # handler (Iznik PR #1195) is deployed, so it 504s against the global 50s
  # timeout server. Give JUST this path longer; remove once the deploy lands
  # if desired (harmless to keep - the endpoint drops to ~20s).
  acl rippling_analytics path_beg /apiv2/rippling/analytics
  http-request set-timeout server 180s if rippling_analytics
  stick-table type ip size 200k expire 30m
  stick on src
  option redispatch
  option forwardfor
  http-request set-header X-Real-IP %[src]

  # Apply graduated delay on response for heavy users.
  http-response lua.rate_delay

  # CORS on HAProxy-generated errors (see https_frontend for rationale).
  http-after-response set-header Access-Control-Allow-Origin "*" unless { res.hdr(Access-Control-Allow-Origin) -m found }

  server db1-katapult __IP_db1-katapult__:8192 check backup
  server db2-katapult __IP_db2-katapult__:8192 check backup
  server db3-katapult __IP_db3-katapult__:8192 check

frontend tusd_frontend
  bind *:8080 ssl crt /etc/haproxy/uploads.ilovefreegle.org.pem alpn h2,http/1.1
  redirect scheme https if !{ ssl_fc }
  mode http
  no option http-buffer-request

  default_backend tusd_backend

backend tusd_backend
  mode http
  balance leastconn
  no option http-buffer-request
  stick-table type ip size 200k expire 30m
  stick on src
  option redispatch
  http-request set-header X-Forwarded-Proto "https"
  http-request add-header X-Forwarded-For %[src]
  http-response add-header Access-Control-Allow-Origin *
  http-response add-header Access-Control-Allow-Headers 'Authorization, Origin, X-Requested-With, X-Request-ID, X-HTTP-Method-Override, Content-Type, Upload-Length, Upload-Offset, Tus-Resumable, Upload-Metadata, Upload-Defer-Length, Upload-Concat, Upload-Complete, Upload-Draft-Interop-Version, x-token, baggage, sentry-trace'
  http-response add-header Access-Control-Allow-Methods 'POST, HEAD, PATCH, OPTIONS, GET, DELETE'
  http-response add-header Access-Control-Expose-Headers 'Location,Upload-Offset,Upload-Length'
  server edge __IP_edge__:8188 check

# Stick table backend for per-user rate limiting.
# This backend is never used for routing - it only holds the stick-table.
backend per_user_rates
  stick-table type string len 20 size 100k expire 1m store http_req_rate(1s),conn_cur

# Shared per-IP stick-table referenced by both https_frontend and api_server_frontend.
# Prevents clients from doubling their effective limit by splitting traffic across ports.
backend per_ip_rates
  stick-table type ip size 100k expire 1m store http_req_rate(1s),conn_cur

# LetsEncrypt backend for certbot renewal
backend letsencrypt-backend
  mode http
  server letsencrypt __IP_letsencrypt__:8888

backend modtools_netlify_backend
  mode http
  #http-request set-header Host modtools--golden-caramel-d2c3a7.netlify.app
  #server netlify modtools--golden-caramel-d2c3a7.netlify.app:443 ssl verify none
  http-request set-header Host modtools-org.netlify.app
  server netlify modtools-org.netlify.app:443 ssl verify none

listen stats
  bind :1936
  mode http
  stats enable
  stats hide-version
  stats realm Haproxy\ Statistics
  stats uri /
  stats auth __STATS_USER__:__STATS_PASSWORD__


backend spatial_backend
  mode http
  option forwardfor
  option httpchk GET /health
  http-request set-header X-Real-IP %[src]
  server db3-katapult __IP_db3-katapult__:8196 check
  server db1-katapult __IP_db1-katapult__:8196 check backup
  server db2-katapult __IP_db2-katapult__:8196 check backup

# AI support helper (FreegleDocker ai-support-helper on the FD host, :8083).
# The /api/ai-support prefix is stripped so the service sees its own routes
# (/api/log-analysis, /health). Analyses are long-running agentic SSE streams,
# hence the extended server/tunnel timeouts (global timeout server is 50s).
backend ai_support_backend
  mode http
  option forwardfor
  option httpchk GET /health
  http-request set-header X-Real-IP %[src]
  http-request replace-path ^/api/ai-support(/.*)$ \1
  http-request replace-path ^/api/ai-support$ /
  timeout server 300s
  timeout tunnel 300s
  server fd __IP_fd__:8083 check
