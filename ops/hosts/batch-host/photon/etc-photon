#!/bin/bash
# Photon geocoder launcher (site-critical, port 2322). Invoked by monit:
#   /etc/monit/conf.d/photon -> start program = "/etc/photon"
#
# setsid is REQUIRED. Backgrounding with plain `nohup ... &` leaves the JVM in
# monit's own process group, and monit tears that group down when this script
# exits - so the JVM died seconds after every start and monit looped forever
# (2026-08-21 reboot: restart attempts every 2 min from 11:16, never came up).
# setsid puts it in its own session so it survives.
#
# -Xmx4g is REQUIRED. Without an explicit cap the JVM tries to reserve ~25% of
# RAM and fails to start during a boot storm (2026-07-02 / 07-03 reboots). The
# ~6.3G ES index is mmap'd/page-cache, not heap, so 4G is ample.
#
# Log to a file: monit's stdout is not a tty, so nohup's implicit nohup.out does
# NOT apply and startup errors were being discarded entirely.
cd /var/www/photon || exit 1
setsid bash -c 'exec java -Xmx4g -jar photon-*.jar -listen-ip 127.0.0.1 -cors-any >> /var/log/photon-start.log 2>&1' < /dev/null &
