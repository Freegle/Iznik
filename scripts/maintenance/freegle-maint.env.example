# /etc/freegle-maint/freegle-maint.env on the Docker host. Not in git.
# Every value has a default in scripts/maintenance/lib/*.sh; set only what differs.
# No secrets belong here: the alert address defaults to monit's.

# Hosts the timers run for real. Empty = every scheduled run is a dry run.
# Add one host at a time. Names: db2-internal db3-internal db1-internal
# ha-internal bulk2-internal docker
MAINT_LIVE_HOSTS=""

# Mail the dry-run summaries too (useful for the first weeks).
MAINT_MAIL_DRY_RUN_SUMMARY=1
# MAINT_ALERT_EMAIL=           # defaults to the `set alert` address in monit's config

# Reboot every N days of uptime even when patching does not ask for it, to clear
# slow leaks. 0 = only when patching needs it.
MAINT_FORCE_REBOOT_DAYS=0

# The load balancer has no standby; its reboot is a short public outage.
MAINT_LB_ALLOW_REBOOT=0

# Data-node order: the first is done in even weeks from the epoch, the second in odd.
# MAINT_DB_ROTATION="db2-internal db3-internal"

# Start windows, UTC.
# MAINT_WINDOW_DB=0440-0505
# MAINT_WINDOW_ARBITRATOR=0440-0505
# MAINT_WINDOW_MAIL=0215-0240
# MAINT_WINDOW_DOCKER=2335-2355
# MAINT_WINDOW_LB=0310-0330

# Packages never upgraded by this tool (each is an operation of its own).
# MAINT_DB_APT_EXCLUDE='^percona-'
# MAINT_ARB_APT_EXCLUDE='^percona-'
# MAINT_LB_APT_EXCLUDE='^haproxy'
# MAINT_DOCKER_APT_EXCLUDE='^(docker-ce.*|containerd\.io|docker-compose-plugin|docker-buildx-plugin)$'
