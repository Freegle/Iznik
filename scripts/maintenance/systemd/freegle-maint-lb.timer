# Load balancer (ha): 04:00 UK time, when its reboot outage is accepted.
# Install: cp to /etc/systemd/system/, systemctl daemon-reload,
# systemctl enable --now freegle-maint-lb.timer. Shipped disabled.
[Unit]
Description=Freegle host maintenance timer: lb

[Timer]
OnCalendar=Mon *-*-* 04:00:00 Europe/London
# A missed slot is skipped, never run late: the start window would refuse it anyway.
Persistent=false
AccuracySec=1min
Unit=freegle-maint@lb.service

[Install]
WantedBy=timers.target
