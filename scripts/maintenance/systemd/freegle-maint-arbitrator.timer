# Arbitrator (db1): three days clear of the data-node slot, 29h after the Docker host, same quiet window.
# Install: cp to /etc/systemd/system/, systemctl daemon-reload,
# systemctl enable --now freegle-maint-arbitrator.timer. Shipped disabled.
[Unit]
Description=Freegle host maintenance timer: arbitrator

[Timer]
OnCalendar=Fri *-*-* 04:40:00 UTC
# A missed slot is skipped, never run late: the start window would refuse it anyway.
Persistent=false
AccuracySec=1min
Unit=freegle-maint@arbitrator.service

[Install]
WantedBy=timers.target
