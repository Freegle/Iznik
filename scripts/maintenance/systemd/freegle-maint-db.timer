# Data node (db2 one week, db3 the next): after the backup drain and before the morning digest.
# Install: cp to /etc/systemd/system/, systemctl daemon-reload,
# systemctl enable --now freegle-maint-db.timer. Shipped disabled.
[Unit]
Description=Freegle host maintenance timer: db

[Timer]
OnCalendar=Tue *-*-* 04:40:00 UTC
# A missed slot is skipped, never run late: the start window would refuse it anyway.
Persistent=false
AccuracySec=1min
Unit=freegle-maint@db.service

[Install]
WantedBy=timers.target
