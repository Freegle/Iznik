#!/usr/bin/env bash
#
# Optional pre-commit hook: lint, docs and dependency licences.
#
# Steps 1 to 3 are cheap, local and advisory - they never block your commit (CI is
# where the freshness and licence gates are enforced hard):
#
#   1. Runs the documentation freshness gate on your STAGED changes, so if you
#      staged a change to code a doc covers without updating the doc, you get a
#      heads-up now instead of in CI.
#   2. If you staged UI changes, reminds you to regenerate the doc screenshots.
#      It does NOT run Playwright here - screenshot regen needs the app running
#      and is far too slow for a commit hook. See docs/screenshots/README.md.
#   3. If you staged a lock file, checks that any dependency it adds has a licence
#      compatible with Freegle's, AGPL-3.0-or-later.
#
# Step 4 BLOCKS: if you staged iznik-nuxt3 code, it runs eslint on it the way CI's
# lint-nuxt job does (errors only). CI fails the build on those errors, so committing
# them only costs a second CI run. Fix with `npx eslint --fix <file>` in iznik-nuxt3.
#
# Install (optional):
#   ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit
# or, if you already have a pre-commit hook (e.g. the lint one), append the
# commands below to it, or use a hook manager to run both.
#
# Bypass any hook with:  git commit --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# 1. Freshness gate on staged changes (advisory).
if command -v node >/dev/null 2>&1 && [ -f scripts/check-docs-freshness.mjs ]; then
  node scripts/check-docs-freshness.mjs --staged --warn || true
fi

# 2. Screenshot regen reminder if UI files are staged.
UI_STAGED="$(git diff --cached --name-only | grep -E '^iznik-nuxt3/(pages|components|modtools)/' || true)"
if [ -n "$UI_STAGED" ]; then
  echo ""
  echo "ℹ️  You changed UI files. If the visuals moved, regenerate the doc screenshots:"
  echo "      cd iznik-nuxt3 && node tests/e2e/docs-screenshots.mjs"
  echo "    (needs the app running; see docs/screenshots/README.md). Not doing it now."
  echo ""
fi

# 3. Licence check if a lock file is staged (advisory).
if command -v node >/dev/null 2>&1 && git diff --cached --name-only | grep -qE '(^|/)(package-lock\.json|composer\.lock|go\.mod)$'; then
  node scripts/check-dependency-licences.mjs --staged || true
fi

# 4. eslint on staged iznik-nuxt3 code (blocks, like CI).
if command -v node >/dev/null 2>&1 && [ -f scripts/lint-staged-nuxt.mjs ]; then
  node scripts/lint-staged-nuxt.mjs
fi

exit 0
